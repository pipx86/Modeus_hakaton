# --- Go / build artifacts ---
bin/
*.exe
*.test
coverage.out
coverage-ai.out
coverage-db.out
coverage-db-unit.out
*.coverprofile
# Ad-hoc `go test -coverprofile=auth` / `total` runs at the repo root.
/auth
/total
e2e-output.json

# --- Environment and secrets ---
.env
.env.*
!.env.example
.secrets/
go.work
go.work.sum

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Logs ---
logs/
*.log

# --- Generated data ---
data/acceptance/
data/reports/

# --- Editor / tool workspace metadata ---
# Postman workspace metadata is local-only; the importable collection with
# request examples lives in postman/ and is tracked.
.postman/

# --- Editors and OS ---
**/.vscode/*
!**/.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Full prompt texts are local-only; the public repo ships safe defaults.
prompts/_shared/
prompts/interviewer/
prompts/analyst/
prompts/synthesizer/
