# Build context hygiene: keep the Docker build fast and secret-free.
.git
.gitignore
.gitattributes
.github
.worktrees
bin
coverage.out
*.exe
*.test
*.log
logs
.env
.env.*
!.env.example
# Local credentials/key material must never enter the build context.
.secrets
secrets/
data/
e2e-output.json
node_modules
# Docker build assets are under deploy/docker (healthcheck probe); the rest of
# deploy is runtime configuration mounted by compose, not image content.
deploy/grafana
deploy/n8n
deploy/nginx
deploy/prometheus
docs
web
docker-compose*.yml
Dockerfile
.dockerignore
Makefile
README.md
openapi.yaml
scripts
