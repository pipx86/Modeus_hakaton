{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "vacancy",
        "interview",
        "standard",
        "document"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    }
  }
}
