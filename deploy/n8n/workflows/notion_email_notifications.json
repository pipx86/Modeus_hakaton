      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normalize a Notion (or any other service) webhook payload into one item.\n// Webhook trigger input: { headers, params, query, body }.\n// Manual trigger input: {} - the code then produces a demo notification so the\n// SMTP settings can be verified end to end from the n8n UI.\nconst incoming = $input.first()?.json ?? {};\nconst isWebhook =\n  Object.prototype.hasOwnProperty.call(incoming, 'body') ||\n  Object.prototype.hasOwnProperty.call(incoming, 'headers');\nconst body =\n  isWebhook && incoming.body && typeof incoming.body === 'object' && !Array.isArray(incoming.body)\n    ? incoming.body\n    : {};\nconst hasBody = Object.keys(body).length > 0;\nconst pick = (...values) =>\n  values.find((value) => value !== undefined && value !== null && String(value).trim() !== '') ?? '';\n\n// Required deployment configuration (see deploy/n8n/workflows/README.md).\n// SMTP_HOST/PORT/USER/PASS are validated here so a misconfigured deployment\n// fails loudly; the actual SMTP transport lives in the n8n 'smtp' credential.\nconst smtpHost = $env.SMTP_HOST ?? '';\nconst smtpPort = $env.SMTP_PORT ?? '';\nconst smtpUser = $env.SMTP_USER ?? '';\nconst smtpPass = $env.SMTP_PASS ?? '';\nconst mailFrom = $env.MAIL_FROM ?? '';\nconst mailTo = $env.MAIL_TO ?? '';\n\nconst missingEnv = [];\nif (!smtpHost) missingEnv.push('SMTP_HOST');\nif (!smtpPort) missingEnv.push('SMTP_PORT');\nif (!smtpUser) missingEnv.push('SMTP_USER');\nif (!smtpPass) missingEnv.push('SMTP_PASS');\nif (!mailFrom) missingEnv.push('MAIL_FROM');\nif (!mailTo) missingEnv.push('MAIL_TO');\n\nconst problems = [];\nif (missingEnv.length > 0) {\n  problems.push('Missing environment variable(s): ' + missingEnv.join(', '));\n}\n\n// Generic field mapping: Notion automation/webhook payloads can be adapted by\n// adding aliases to these pick() lists.\nlet title = pick(body.title, body.page_title, body.pageTitle, body.name, body.subject);\nlet url = pick(body.url, body.page_url, body.pageUrl, body.link, body.public_url);\nlet event = pick(body.event, body.event_type, body.type, body.action, body.trigger);\nlet pageId = pick(body.page_id, body.pageId, body.id);\nlet actor = pick(body.actor, body.edited_by, body.last_edited_by, body.user);\nlet timestamp = pick(body.timestamp, body.occurred_at, body.created_at, body.last_edited_time);\nlet isDemo = false;\n\nif (isWebhook && !hasBody) {\n  problems.push('Webhook body is empty or not a JSON object (send Content-Type: application/json)');\n} else if (!isWebhook) {\n  isDemo = true;\n  title = title || 'Manual test of the Notion notification workflow';\n  event = event || 'workflow.test';\n  actor = actor || 'n8n manual run';\n  timestamp = timestamp || $now.toISO();\n} else if (!title && !url && !event && !pageId) {\n  problems.push('Payload has no recognizable title/url/event/page_id fields (check the field mapping)');\n}\n\nreturn [\n  {\n    json: {\n      title: title || '(untitled page)',\n      url,\n      event: event || 'page.updated',\n      page_id: pageId,\n      actor: actor || 'unknown',\n      timestamp: timestamp || $now.toISO(),\n      received_at: $now.toISO(),\n      is_webhook: isWebhook,\n      is_demo: isDemo,\n      config_error: problems.join('; '),\n      mail_from: mailFrom,\n      mail_to: mailTo,\n      smtp_host: smtpHost,\n      smtp_port: smtpPort,\n    },\n  },\n];\n"
      },
