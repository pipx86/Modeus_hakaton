# Local development configuration for the Go backend DevOps stack.
# Copy to .env (`make env`) and change every password before use. Never commit
# a real .env: it is git-ignored and this file must only contain placeholders.

APP_ENV=local
LOG_LEVEL=info

# api / web (docker-compose.yml)
API_PORT=8080
WEB_PORT=8081
HTTP_ADDR=:8080

# --- Auth (internal/auth) ----------------------------------------------
# HMAC secret for bearer tokens used by the protected /api/v1 endpoints.
# Generate: openssl rand -hex 32. Left empty here on purpose: the compose
# fallback is a local placeholder, and production must inject a real secret.
JWT_SECRET=

# --- LLM provider (optional for the demo API) --------------------------
# LLM provider (OpenAI-compatible). The provider key is required for live
# interviews; without it the server uses deterministic fallback questions.
# Keep the key in the git-ignored .secrets/ directory, never in .env.example.
LLM_BASE_URL=https://api.reformboss.com/v1
LLM_API_KEY=
LLM_API_KEY_FILE=.secrets/reformboss.key
LLM_MODEL=deepseek-v4.1-flash-1017
# Optional per-agent overrides; live-tested values are in
# docs/LLM_TEMPERATURE_REPORT.md. Do not lower analyst max tokens below 5000:
# with 1500 the provider returns an empty/truncated analyst response.
# Live data: analyst completion reached 4829/5000 at temp 0.5; keep 8000 for
# headroom. max_tokens is a cap, not a pre-charge.
LLM_TIMEOUT_S=300
LLM_INTERVIEWER_MODEL=deepseek-v4.1-flash-1017
LLM_INTERVIEWER_TEMPERATURE=0.2
LLM_INTERVIEWER_MAX_TOKENS=1500
LLM_INTERVIEWER_TIMEOUT_S=300
LLM_ANALYST_MODEL=deepseek-v4.1-flash-1017
LLM_ANALYST_TEMPERATURE=0.2
LLM_ANALYST_MAX_TOKENS=8000
LLM_ANALYST_TIMEOUT_S=300
# Backwards-compatible aliases:
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=...

# Production server (cmd/server) needs PostgreSQL; the demo api ignores it.
DATABASE_URL=

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=activity
POSTGRES_PASSWORD=activity_dev_password
POSTGRES_DB=activity_descriptor
POSTGRES_PORT=5432

# prometheus / grafana (profile monitoring)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=activity_dev_password

# n8n (profile automation)
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_dev_password
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n_dev_password
# Consumed by deploy/n8n/workflows/nightly_ingestion.json
INGESTION_URL=http://api:8080/api/v1/ingest
# Telegram chat for the (disabled by default) error-alert node; leave empty to skip
TELEGRAM_CHAT_ID=
# SMTP for deploy/n8n/workflows/notion_email_notifications.json (leave empty to skip email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=


# OpenTelemetry OTLP/HTTP tracing. Empty endpoint keeps spans local (no network).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=
