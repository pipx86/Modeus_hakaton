# Local development configuration for the Go backend DevOps stack.
# Copy to .env (`make env`) and change every password before use. Never commit
# a real .env: it is git-ignored and this file must only contain placeholders.

APP_ENV=local
LOG_LEVEL=info

# api / web (docker-compose.yml)
API_PORT=8080
WEB_PORT=8081
WEB_SERVER_PORT=8083
HTTP_ADDR=:8080

# --- Auth (internal/auth) ----------------------------------------------
# HMAC secret for bearer tokens used by the protected /api/v1 endpoints.
# Generate: openssl rand -hex 32. Left empty here on purpose: the compose
# fallback is a local placeholder, and production must inject a real secret.
JWT_SECRET=

# --- LLM provider (optional for the demo API) --------------------------
# LLM provider (OpenAI-compatible). The provider key is required for live
# interviews; without it the server uses deterministic fallback questions.
# Keep the key in the git-ignored .secrets/ directory, never in .env.example.
LLM_BASE_URL=https://api.reformboss.com/v1
LLM_API_KEY=
LLM_API_KEY_FILE=.secrets/reformboss.key
LLM_MODEL=deepseek-v4.1-flash-1017
# Optional per-agent overrides; live-tested values are in
# README.md. Do not lower analyst max tokens below 5000:
# with 1500 the provider returns an empty/truncated analyst response.
# Live data: analyst completion reached 4829/5000 at temp 0.5; keep 8000 for
# headroom. max_tokens is a cap, not a pre-charge.
LLM_TIMEOUT_S=300
LLM_INTERVIEWER_MODEL=deepseek-v4.1-flash-1017
LLM_INTERVIEWER_TEMPERATURE=0.2
LLM_INTERVIEWER_MAX_TOKENS=1500
LLM_INTERVIEWER_TIMEOUT_S=300
# Best live analyst by quality/latency/cost; fallback: deepseek-v4.1-flash-1017
LLM_ANALYST_MODEL=minimax-m3.1-flash
LLM_ANALYST_TEMPERATURE=0.2
LLM_ANALYST_MAX_TOKENS=8000
LLM_ANALYST_TIMEOUT_S=300
# Optional fallback model per agent: used only for transient primary failures
# (timeout, 5xx/429, empty or schema-invalid answer, open circuit breaker).
# Permanent failures (401/4xx, guardrail block) are reported, never hidden.
# Empty = disabled (primary-only behaviour). The fallback reuses
# LLM_BASE_URL/LLM_API_KEY, the same guardrails, circuit breaker and shared
# request gate, plus this agent's temperature/max-tokens/reasoning settings.
# It must differ from the primary model.
LLM_ANALYST_FALLBACK_MODEL=deepseek-v4.1-flash-1017
# Synthesizer is the third LLM agent: it normalizes titles/descriptions after
# the deterministic merge; ids, hierarchy, evidence and conflicts stay in code.
LLM_SYNTHESIZER_MODEL=deepseek-v4.1-flash-1017
LLM_SYNTHESIZER_TEMPERATURE=0.1
LLM_SYNTHESIZER_MAX_TOKENS=4000
LLM_SYNTHESIZER_TIMEOUT_S=300
# LLM_INTERVIEWER_FALLBACK_MODEL=
# hh.ru application OAuth (server-to-server client_credentials).
# Client id/secret are app credentials, not an access token. Keep real values
# only in the git-ignored .env or .secrets/, never in this example.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_USER_AGENT=ModeusHackathon/1.0 (your-contact@your-domain.ru)
HH_TOKEN_URL=https://hh.ru/oauth/token

# Optional automatic vacancy import in the backend. Set a search query to
# enable it; the importer uses client_credentials and refreshes the app token.
HH_IMPORT_QUERY=
HH_IMPORT_INTERVAL_H=24
HH_IMPORT_PAGES=1
# Optional explicit path for the short-lived token cache. Defaults to the OS
# user cache directory; never put this file in the repository.
HH_TOKEN_CACHE=

# Backwards-compatible aliases:
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=...

# --- Semantic search / embeddings (Ollama) ------------------------------
# Optional: defaults already point at a local Ollama and the pulled
# nomic-embed-text model, so the backend works without editing this section.
# Vectors are stored only when the optional migrations/optional/vector package
# is applied (the compose `server` profile applies it automatically).
# Docs: README.md
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# RAG retriever of the post-interview finalizer: vector (cosine only) or
# hybrid (RRF of BM25 and vector ranks). Default is hybrid.
RAG_SEARCH_STRATEGY=hybrid
RAG_SEARCH_LIMIT=8
# Background indexing of sources created through the API. Set false to skip
# Ollama calls on a host without the model.
SOURCE_AUTO_INDEX=true

# Production server (cmd/server) needs PostgreSQL; the demo api ignores it.
DATABASE_URL=

# Full backend compose profile (cmd/server):
#   docker compose --profile server up -d --build server
# Host port for the backend container (8080 = demo api, 8081 = web UI).
SERVER_PORT=8082
# Optional DSN override for the in-container backend. Leave empty to use the
# compose `postgres` service. The value must be reachable from inside the
# container: a host `localhost` URL points at the container itself.
SERVER_DATABASE_URL=
# The profile reads JWT_SECRET and LLM_* from this file and from the git-ignored
# .secrets/llm.env (both optional env_file entries). See README.md.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=activity
POSTGRES_PASSWORD=activity_dev_password
POSTGRES_DB=activity_descriptor
POSTGRES_PORT=5432

# prometheus / grafana (profile monitoring)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=activity_dev_password

# n8n (profile automation)
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_dev_password
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n_dev_password
# Consumed by deploy/n8n/workflows/nightly_ingestion.json
INGESTION_URL=http://api:8080/api/v1/ingest
# Telegram chat for the (disabled by default) error-alert node; leave empty to skip
TELEGRAM_CHAT_ID=# SMTP for deploy/n8n/workflows/notion_email_notifications.json (leave empty to skip email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=


# OpenTelemetry OTLP/HTTP tracing. Empty endpoint keeps spans local (no network).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=

# --- OpenAlex (publication subscriptions / research feed) -----------------
# API key for higher rate limits and polite pool access.
# Docs: https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
# Pass as query param api_key=... or header. Used by external pollers / n8n /
# future ingest workers that call api.openalex.org for source=openalex topics.
# Keep the real key only in the git-ignored .env or .secrets/, never commit it.
OPENALEX_API_KEY=
# Optional: email for the polite pool when no key is set (OpenAlex recommends it).
# OPENALEX_MAILTO=
# Optional API for deferred features (see README).
MODEUS_ENABLE_DEFERRED_API=false
